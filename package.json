{
  "name": "cogitoagent",
  "version": "2.3.2",
  "description": "CogitoAgent - 持续思考的智能体",
  "author": "雪豹同志@cnt-code/Snow leopard (@SnowLeopard-io)",
  "license": "Apache-2.0",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "start": "chcp 65001 > nul && cross-env COGITO_MODE=dashboard electron .",
    "electron": "chcp 65001 > nul && cross-env COGITO_MODE=dashboard electron .",
    "electron:desktop": "chcp 65001 > nul && cross-env COGITO_MODE=desktop electron .",
    "electron:dashboard": "chcp 65001 > nul && cross-env COGITO_MODE=dashboard electron .",
    "cli": "chcp 65001 > nul && cross-env CLI_MODE=true DISABLE_WS=true npx tsx src/index.ts",
    "cli:js": "chcp 65001 > nul && cross-env CLI_MODE=true DISABLE_WS=true npx tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e",
    "test:e2e:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e --watch",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:nsis": "electron-builder --win --nsis",
    "typecheck": "npx tsc --noEmit"
  },
  "dependencies": {
    "@pawastation/ilink-bot-sdk": "^0.2.0",
    "@unblessed/node": "^1.0.0-alpha.23",
    "cheerio": "^1.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.11",
    "dotenv": "^16.4.5",
    "echarts": "^6.1.0",
    "electron": "^42.5.0",
    "isolated-vm": "^6.1.2",
    "marked": "^18.0.5",
    "nodemailer": "^9.0.1",
    "playwright": "^1.61.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.10.0",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "cross-env": "^7.0.3",
    "electron-builder": "^25.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "js-yaml": "4.2.0",
    "tar": "^7.4.3",
    "glob": "^13.0.6"
  }
}
