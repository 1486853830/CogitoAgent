{
  "name": "cogitoagent",
  "version": "2.3.2",
  "description": "CogitoAgent - 持续思考的智能体 / Think Continuously, Act Autonomously, Stay Private",
  "author": "雪豹同志@cnt-code/Snow leopard (@SnowLeopard-io)",
  "license": "Apache-2.0",
  "main": "electron/main.js",
  "type": "module",
  "files": [
    "src/",
    "electron/",
    "personas/",
    "plugins/",
    "introduction/",
    "workflows/",
    "tsconfig.json",
    "tsconfig.test.json",
    "eslint.config.mjs",
    "jest.config.mjs",
    ".prettierrc",
    ".env.example",
    "Dockerfile",
    "docker-compose.yml",
    "electron-builder.yml",
    "index.html"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SnowLeopard-io/CogitoAgent.git"
  },
  "homepage": "https://github.com/SnowLeopard-io/CogitoAgent#readme",
  "bugs": {
    "url": "https://github.com/SnowLeopard-io/CogitoAgent/issues"
  },
  "keywords": [
    "ai-agent",
    "autonomous-ai",
    "llm",
    "typescript",
    "electron",
    "privacy-first",
    "local-ai",
    "agent-framework",
    "mcp",
    "tool-execution",
    "multi-agent"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "chcp 65001 > nul && cross-env COGITO_MODE=dashboard electron .",
    "electron:dashboard": "chcp 65001 > nul && cross-env COGITO_MODE=dashboard electron .",
    "electron:desktop": "chcp 65001 > nul && cross-env COGITO_MODE=desktop electron .",
    "cli": "chcp 65001 > nul && cross-env CLI_MODE=true DISABLE_WS=true npx tsx src/index.ts",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e",
    "test:e2e:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js tests/e2e --watch",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:nsis": "electron-builder --win nsis",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src electron plugins",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" \"electron/**/*.{js,json}\"",
    "prepare": "husky",
    "postinstall": "patch-package",
    "prepublishOnly": "npm run typecheck && npm test",
    "publish:npm": "npm publish --access public"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@pawastation/ilink-bot-sdk": "^0.2.0",
    "cheerio": "^1.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.13",
    "dotenv": "^16.4.5",
    "echarts": "^6.1.0",
    "isolated-vm": "^7.0.1",
    "jszip": "^3.10.1",
    "marked": "^18.0.5",
    "nodemailer": "^9.0.1",
    "playwright": "^1.61.0",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sql.js": "^1.10.0",
    "tsx": "^4.23.1",
    "ws": "^8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.12.0",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.1",
    "babel-plugin-istanbul": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^42.7.0",
    "electron-builder": "^26.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "patch-package": "^8.0.1",
    "prettier": "^3.9.5",
    "ts-jest": "^29.4.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0"
  },
  "overrides": {
    "image-size": "file:vendor/image-size",
    "brace-expansion": "^5.0.9",
    "js-yaml": "^4.3.1",
    "tar": "^7.4.3",
    "glob": "^13.0.6",
    "cacache": "^18.0.0",
    "test-exclude": "^7.0.0",
    "source-map-support": "^0.5.21",
    "cheerio": {
      "undici": "^7.29.0"
    },
    "@electron/get": {
      "undici": "^7.29.0"
    },
    "fast-uri": "^3.1.5"
  }
}
