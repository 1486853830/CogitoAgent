+
+/**
+ * V8 14 / Electron 42 headers require the tagged External pointer API.
+ * Guarded on the module ABI version (like better-sqlite3 #1475) rather than the
+ * V8 version, because several Node releases report V8 14 while still exposing
+ * the old two-argument External::New() and zero-argument External::Value().
+ */
+#if defined(NODE_MODULE_VERSION) && NODE_MODULE_VERSION >= 146
+#define IVM_EXTERNAL_NEW(isolate, value) v8::External::New((isolate), (value), 0)
+#define IVM_EXTERNAL_VALUE(value) ((value)->Value(0))
+#else
+#define IVM_EXTERNAL_NEW(isolate, value) v8::External::New((isolate), (value))
+#define IVM_EXTERNAL_VALUE(value) ((value)->Value())
+#endif
