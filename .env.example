# CogitoAgent 环境变量配置模板
# 复制此文件为 .env 并填入您的实际配置值
# 注意：.env 文件包含敏感信息，请勿提交到版本控制

# ============================================
# API 配置（必需）
# ============================================

# API 密钥（必需）
COGITO_API_KEY=your-api-key-here

# API 服务地址（可选，默认根据 provider 自动设置）
COGITO_API_BASE_URL=https://api.openai.com/v1

# API 服务商名称（可选，支持: openai, moark, anthropic, google）
COGITO_API_PROVIDER=openai

# 模型名称（可选）
COGITO_MODEL=gpt-4o

# ============================================
# 思考循环配置（可选）
# ============================================

# 注意：Agent 思考循环为事件驱动（消息/工具结果即时推进），
# 无固定轮询间隔，本变量已不再被代码读取，保留仅为向后兼容。
# 主动行为层（Heartbeat）默认每 60s 检查工作区 TODO.md，可另行调整。
# COGITO_THINKING_INTERVAL=3000

# ============================================
# 启动模式配置（可选）
# ============================================

# 启动模式: desktop（桌面悬浮模式）/ dashboard（工作台模式）
# 不设置时默认为 dashboard（与 npm start / npm run electron:dashboard 一致），
# 也可通过 npm run electron:desktop / electron:dashboard 覆盖
COGITO_MODE=dashboard

# ============================================
# 联网搜索配置（可选）
# ============================================

# 是否启用联网搜索（默认启用，设为 false 关闭）
COGITO_SEARCH_ENABLED=true

# 搜索服务地址（moark 供应商可留空自动推导；
# 其他供应商必须显式配置，否则搜索工具不可用）
COGITO_SEARCH_BASE_URL=https://your-search-service/v1

# 搜索时间过滤（如 week / month，留空为不过滤）
COGITO_SEARCH_RECENCY_FILTER=

# 搜索站点过滤（留空为不限制）
COGITO_SEARCH_SITE_FILTER=

# ============================================
# WebSocket 服务配置（可选）
# ============================================

# WS 服务监听地址（默认 127.0.0.1；Docker 部署需设为 0.0.0.0）
COGITO_WS_HOST=127.0.0.1

# 是否启用健康检查 HTTP 服务（默认关闭，容器健康检查请设为 true）
COGITO_WS_HEALTH=false

# 健康检查服务端口（默认 9528）
COGITO_WS_HEALTH_PORT=9528

# ============================================
# 日志配置（可选）
# ============================================

# 日志级别（debug / info / warn / error）
LOG_LEVEL=info

# 日志文件路径（留空则不写文件）
COGITO_LOG_FILE=

# 日志单文件最大字节数（默认 10MB）
COGITO_LOG_MAX_BYTES=10485760

# 轮转日志文件数量（默认 5）
COGITO_LOG_MAX_FILES=5

# ============================================
# 数据库配置（可选）
# ============================================

# SQLite 数据库文件路径
COGITO_DATABASE_PATH=./data/example.db

# ============================================
# 邮件配置（可选）
# ============================================

# SMTP 服务器地址
COGITO_EMAIL_HOST=smtp.example.com

# SMTP 端口
COGITO_EMAIL_PORT=587

# 邮箱用户名
COGITO_EMAIL_USER=your-email@example.com

# 邮箱密码
COGITO_EMAIL_PASSWORD=your-email-password

# 发件人邮箱地址
COGITO_EMAIL_FROM=your-email@example.com

# ============================================
# 多模型 API 密钥（可选）
# 推荐使用 COGITO_ 前缀版本；无前缀版本（如 OPENAI_API_KEY）仍向后兼容
# ============================================

# OpenAI API 密钥
COGITO_OPENAI_API_KEY=your-openai-api-key

# Moark API 密钥
COGITO_MOARK_API_KEY=your-moark-api-key

# Anthropic API 密钥
COGITO_ANTHROPIC_API_KEY=your-anthropic-api-key

# Google API 密钥
COGITO_GOOGLE_API_KEY=your-google-api-key

# ============================================
# OCR 图像文字识别配置（可选）
# 不设置时 OCR_API_KEY 回退到主 API Key (COGITO_API_KEY)
# 同样推荐 COGITO_ 前缀版本；无前缀版本（如 OCR_API_KEY）仍向后兼容
# ============================================

# OCR API 密钥
COGITO_OCR_API_KEY=your-ocr-api-key

# OCR API 服务地址
COGITO_OCR_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# OCR 模型名称
COGITO_OCR_MODEL=InternVL3-78B

# OCR 服务商名称
COGITO_OCR_PROVIDER=qwen-vl

# ============================================
# 视觉分析配置（可选）
# 用于分析图片内容（描述、理解、问答等），支持流式返回思考过程
# 不设置时 VISION_API_KEY 回退到主 API Key (COGITO_API_KEY)
# 同样推荐 COGITO_ 前缀版本；无前缀版本（如 VISION_API_KEY）仍向后兼容
# ============================================

# 视觉分析 API 密钥（可选，默认回退到 COGITO_API_KEY）
COGITO_VISION_API_KEY=

# 视觉分析 API 服务地址（可选，默认使用 COGITO_API_BASE_URL）
COGITO_VISION_API_BASE_URL=

# 视觉模型名称（可选，默认 InternVL3-78B）
COGITO_VISION_MODEL=InternVL3-78B

# ============================================
# 图像生成配置（可选）
# 调用 OpenAI 兼容的 images/generations 接口文生图 / 图生图（默认 moark 的 qwen-image）
# 密钥回退链：COGITO_IMAGEGEN_API_KEY → COGITO_MOARK_API_KEY → COGITO_API_KEY
# 即：若你的生图密钥与语言模型是同一个，通常无需单独设置本段，
#     生图会自动复用 COGITO_API_KEY（或 COGITO_MOARK_API_KEY）。
#     仅当生图需用独立密钥/服务时才显式填写以下变量。
# 同样推荐 COGITO_ 前缀版本；无前缀版本（如 IMAGEGEN_API_KEY）仍向后兼容
# ============================================

# 图像生成 API 密钥（可选，默认回退到 COGITO_API_KEY / COGITO_MOARK_API_KEY）
COGITO_IMAGEGEN_API_KEY=

# 图像生成 API 服务地址（可选，默认 https://api.moark.com/v1）
COGITO_IMAGEGEN_API_BASE_URL=

# 图像生成模型名称（可选，默认 qwen-image-2.0-pro）
COGITO_IMAGEGEN_MODEL=qwen-image-2.0-pro

# ============================================
# 代码执行配置（可选）
# ============================================

# 代码执行超时时间（毫秒）
COGITO_CODE_TIMEOUT=30000

# 代码输出最大大小（字符）
COGITO_CODE_MAX_OUTPUT=100000

# 科学模式（可选，默认关闭）
# 启用后 Python 执行环境将保留完整 PATH 和 PYTHONPATH，
# 允许加载已安装的科学计算库（NumPy, SciPy, RDKit, Biopython 等）
# 注意：此模式会降低安全性，仅应在信任的环境中开启
# COGITO_CODE_SCIENTIFIC_MODE=true

# ============================================
# 安全配置（可选）
# ============================================

# 是否启用危险操作确认（默认启用）
# 设为 false 可跳过 gitPush / executeCode / dropTable 等危险操作的二次确认
COGITO_CONFIRM_DANGEROUS=true

# 是否启用代码沙盒模式（默认启用）
# 设为 false 在执行代码时禁用沙盒隔离（不推荐）
COGITO_SANDBOX_MODE=true

# ============================================
# 工作区配置（可选）
# ============================================

# 工作区根路径
COGITO_WORKSPACE=./

# ============================================
# 人设配置（可选）
# ============================================

# 【已废弃】人设不再从环境变量读取（启动默认套用 Cogito 人设，避免环境覆盖默认人设）。
# 请在 config.json 中设置 "persona": "<文件夹名>" 指定持久默认人设
# （对应 personas/ 目录下的文件夹名，如 "Assistant" / "Programmer"）；
# 留空或不设则默认使用 Cogito 人设。
# COGITO_PERSONA=

# ============================================
# 微信配置（可选）
# ============================================

# 微信 iLink 协议 API 地址（可选，默认使用官方地址）
COGITO_WECHAT_API_BASE_URL=

# 微信消息轮询间隔（毫秒），最小值 1000
COGITO_WECHAT_POLLING_INTERVAL=2000

# 是否启用微信自动回复（默认启用）
COGITO_WECHAT_AUTO_REPLY=true

# ============================================
# 使用说明
# ============================================
# 1. 复制此文件为 .env: cp .env.example .env
# 2. 填入您的实际配置值
# 3. 确保 .env 文件不被提交到 Git（已在 .gitignore 中排除）
# 4. 环境变量优先级高于 config.json 配置
# 5. 多模型密钥和 OCR 密钥同时支持 COGITO_ 前缀和无前缀两种写法，
#    COGITO_ 前缀优先；无前缀版本保留仅为向后兼容
