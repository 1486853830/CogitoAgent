# CogitoAgent 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# ===== API 配置 =====
# API 密钥（优先级高于 config.json）
COGITO_API_KEY=your_api_key_here

# API Base URL
COGITO_API_BASE_URL=https://api.example.com/v1

# API 服务商名称
COGITO_API_PROVIDER=moark

# 模型名称
COGITO_MODEL=gpt-4o

# ===== 思考间隔 =====
# 思考间隔时间（毫秒），最小 1000
COGITO_THINKING_INTERVAL=3000

# ===== 邮箱配置 =====
# SMTP 密码
COGITO_EMAIL_PASSWORD=your_smtp_password

# ===== 工作区 =====
# 工作区根路径
COGITO_WORKSPACE=D:\workspace

# ===== 第三方 API Keys =====
# OpenAI API Key
OPENAI_API_KEY=your_openai_key

# Anthropic API Key
ANTHROPIC_API_KEY=your_anthropic_key

# Google API Key
GOOGLE_API_KEY=your_google_key

# ===== 安全配置 =====
# 是否启用沙箱模式执行代码
COGITO_SANDBOX_MODE=true

# 是否启用危险操作确认
COGITO_CONFIRM_DANGEROUS=true

# ===== 日志级别 =====
# DEBUG, INFO, WARN, ERROR
LOG_LEVEL=INFO